GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
TOKEN_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
SYNC_SECRET=
# Comma-separated Google accounts allowed to log in.
