# Copy to .env and fill in. .env is gitignored; never commit it.
# See the environment variables table in README.md.

# --- Required ---

# Postgres with pgvector. This value matches docker-compose.yml.
DATABASE_URL=postgres://superfer:superfer@localhost:5432/superfer

# OAuth client (type: web application) from Google Cloud. See docs/GOOGLE-OAUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback for connecting Gmail accounts. Must be listed on the OAuth client,
# together with /api/auth/login/callback on the same origin.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encrypts stored OAuth tokens: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Classification, rules and summaries.
ANTHROPIC_API_KEY=

# Comma-separated Google addresses allowed to sign in. Only the owner's own
# addresses: everyone listed sees all mail from every connected account.
ALLOWED_EMAILS=

# Signs the session cookie. At least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Bearer token for /api/sync. Required when sync runs over HTTP (Vercel cron);
# pnpm sync does not use it. Any long random string.
SYNC_SECRET=

# --- Self-hosting with docker-compose.self-host.yml only ---
# See docs/SELF-HOST.md. The compose file builds DATABASE_URL for its own database from this password.

# Password of the bundled database: openssl rand -hex 24
# POSTGRES_PASSWORD=
# Host port and address for the web app. Default 3000 on 127.0.0.1, for a reverse proxy on the same machine.
# WEB_PORT=
# WEB_BIND=

# --- Vercel only ---

# Vercel cron sends this as its bearer token. Set it to the same value as SYNC_SECRET.
# CRON_SECRET=

# --- Optional ---
# Leave commented out to keep the default; an empty value is not the same as unset.

# Sign-in callback. Defaults to /api/auth/login/callback on GOOGLE_REDIRECT_URI's origin.
# LOGIN_REDIRECT_URI=

# Dev only: 1 skips the login gate. Ignored when NODE_ENV is production.
# AUTH_DISABLED=

# Comma-separated Gmail addresses that may be connected as accounts. Unset: any address.
# CONNECTABLE_EMAILS=

# Days a Google refresh token lasts before the account must be reconnected.
# Default 7 (consent screen in Testing mode). 0 turns off expiry warnings (published consent screen).
# GOOGLE_TOKEN_LIFETIME_DAYS=

# Prefix for the bucket labels written back to Gmail. Default: superfer (labels superfer/inbox, ...)
# GMAIL_LABEL_PREFIX=

# Locale for dates in quoted and forwarded headers. Default: en-US
# MAIL_LOCALE=

# TypeSafe Jev second-opinion classifier. Sends sender, subject and the first
# 1500 characters of the body to TypeSafe's API. Unset: never called.
# JEV_API_KEY=
